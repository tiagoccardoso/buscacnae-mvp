# Copie este arquivo para .env antes de rodar o Docker.
# Exemplo no CMD do Windows:
# copy .env.docker.example .env

# App
NEXT_PUBLIC_APP_NAME=BuscaCNAE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SPLINE_SCENE_URL=

# OpenAI CNAE assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# IA Empresarial — "Pergunte ao BuscaCNAE" (docs/IA_EMPRESARIAL.md)
# Planejador: openai (padrão quando OPENAI_API_KEY existe) | rules (intérprete por regras, sem rede).
AI_ASSISTANT_PROVIDER=
# Modelo do assistente (vazio = OPENAI_MODEL).
AI_ASSISTANT_MODEL=
# Tempo máximo por chamada ao modelo, em ms (2000–30000). Estourou → intérprete por regras.
AI_ASSISTANT_TIMEOUT_MS=12000
# Interpretação em linguagem natural (2ª chamada ao modelo). 0 desliga.
AI_ASSISTANT_INTERPRETATION=1
# Perguntas por usuário a cada 10 minutos (por instância do servidor).
AI_ASSISTANT_RATE_LIMIT=30

# Neon PostgreSQL + autenticação própria
DATABASE_URL=
# Segredo usado para assinar o cookie de sessão. Use uma string longa e aleatória.
NEON_AUTH_COOKIE_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/pricing?checkout=cancelled

# Casa dos Dados (única fonte de consulta de empresas; usada apenas no servidor)
CASA_DOS_DADOS_API_KEY=
CASA_DOS_DADOS_TIMEOUT_MS=15000

# Controle de acesso
BYPASS_BILLING=false

# Cache
DISCOVERY_CACHE_TTL_HOURS=24
# Reaproveita por N horas a consulta detalhada (GET /v4/cnpj) já salva, evitando chamadas pagas repetidas. 0 desliga.
DISCOVERY_DETAIL_REUSE_HOURS=168
DISCOVERY_MAX_RESULTS=50
DISCOVERY_PAGE_SIZE=50

# Checkout avulso
MINIMUM_CHECKOUT_AMOUNT_CENTS=50

NEXT_PUBLIC_CONTACT_EMAIL=contato@buscacnae.com.br

# Mapa Empresarial (docs/MAPA_EMPRESARIAL.md)
# Mapa base no navegador: osm (padrão, sem chave) | carto-light | carto-dark | ion | offline
NEXT_PUBLIC_MAP_BASEMAP=osm
# Opcionais e PÚBLICOS (vão para o navegador): restrinja por domínio no painel do fornecedor.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_GOOGLE_MAP_TILES_KEY=
# Geocodificação controlada de CEP (servidor): none (padrão) | brasilapi
MAP_GEOCODING_PROVIDER=none
# Máximo de CEPs novos consultados por abertura do mapa.
MAP_GEOCODING_MAX_LOOKUPS=25
# Teto de marcadores enviados ao navegador por busca.
MAP_MAX_MARKERS=5000
# Teto do universo analisado por busca (Empresas, Mapa e Inteligência usam o mesmo).
# Vazio = herda MAP_MAX_MARKERS. Ver docs/INTELIGENCIA_MERCADO.md.
ANALYSIS_MAX_COMPANIES=
# Máximo de municípios usados por "Buscar nesta área".
MAP_AREA_SEARCH_MAX_CITIES=12

# Diretório de CEP como complemento territorial (Fase 2; nenhum fluxo atual o usa): none (padrão) | opencep
LOCATION_POSTAL_DIRECTORY=none
LOCATION_POSTAL_DIRECTORY_MAX_LOOKUPS=20

# Busca Empresarial Avançada — Fase 7 (docs/BUSCA_AVANCADA.md). Tudo opcional:
# sem MEILISEARCH_URL a busca rápida usa o fallback no PostgreSQL (sem tolerância a erro).
MEILISEARCH_URL=
# Chave de BUSCA (somente leitura) usada nas consultas; vazia = usa a admin.
MEILISEARCH_SEARCH_KEY=
# Chave administrativa usada só pela sincronização (nunca vai ao navegador).
MEILISEARCH_ADMIN_KEY=
# Liga o índice de empresas. Só ative depois de confirmar que o contrato com a Casa dos Dados
# permite indexar os dados cadastrais já armazenados (ver §2 do documento).
SEARCH_COMPANY_INDEX_ENABLED=false
SEARCH_INDEX_PREFIX=buscacnae
# Validade (dias) de um documento a partir da data em que o dado foi obtido na Casa dos Dados.
SEARCH_INDEX_TTL_DAYS=90
# Tempo máximo de uma consulta ao índice antes do fallback (ms).
SEARCH_TIMEOUT_MS=800
SEARCH_SYNC_BATCH_SIZE=1000
# Segredo da rota /api/search/sync (>= 16 caracteres). Vazio = usa CRON_SECRET.
SEARCH_SYNC_SECRET=
# docker compose --profile search: chave mestra do Meilisearch (>= 16 bytes)
MEILI_MASTER_KEY=
