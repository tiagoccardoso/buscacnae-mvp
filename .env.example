# App
NEXT_PUBLIC_APP_NAME=BuscaCNAE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SPLINE_SCENE_URL=

# OpenAI CNAE assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Neon PostgreSQL + autenticação própria
DATABASE_URL=
# Segredo usado para assinar o cookie de sessão. Use uma string longa e aleatória.
NEON_AUTH_COOKIE_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/pricing?checkout=cancelled

# Casa dos Dados (única fonte de consulta de empresas; usada apenas no servidor)
CASA_DOS_DADOS_API_KEY=
# Timeout por requisição em milissegundos (padrão 15000).
CASA_DOS_DADOS_TIMEOUT_MS=15000

# Controle de acesso
# true = libera busca mesmo sem assinatura ativa (útil no desenvolvimento)
BYPASS_BILLING=false

# Cache
DISCOVERY_CACHE_TTL_HOURS=24
# Reaproveita por N horas a consulta detalhada (GET /v4/cnpj) já salva, evitando chamadas pagas repetidas. 0 desliga.
DISCOVERY_DETAIL_REUSE_HOURS=168
# Máximo de empresas carregadas por combinação CNAE x localidade (padrão de segurança: 1000).
DISCOVERY_MAX_RESULTS=50
# Registros por página na pesquisa da Casa dos Dados.
DISCOVERY_PAGE_SIZE=50

# Checkout avulso
MINIMUM_CHECKOUT_AMOUNT_CENTS=50

NEXT_PUBLIC_CONTACT_EMAIL=contato@buscacnae.com.br

# Mapa Empresarial (docs/MAPA_EMPRESARIAL.md)
# Mapa base no navegador: osm (padrão, sem chave) | carto-light | carto-dark | ion | offline
NEXT_PUBLIC_MAP_BASEMAP=osm
# Opcionais e PÚBLICOS (vão para o navegador): restrinja por domínio no painel do fornecedor.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_GOOGLE_MAP_TILES_KEY=
# Geocodificação controlada de CEP (servidor): none (padrão) | brasilapi
MAP_GEOCODING_PROVIDER=none
# Máximo de CEPs novos consultados por abertura do mapa.
MAP_GEOCODING_MAX_LOOKUPS=25
# Teto de marcadores enviados ao navegador por busca.
MAP_MAX_MARKERS=5000
# Máximo de municípios usados por "Buscar nesta área".
MAP_AREA_SEARCH_MAX_CITIES=12

# Diretório de CEP como complemento territorial (Fase 2; nenhum fluxo atual o usa): none (padrão) | opencep
LOCATION_POSTAL_DIRECTORY=none
LOCATION_POSTAL_DIRECTORY_MAX_LOOKUPS=20
